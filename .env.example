# Copy to .env.local at the repo root: cp .env.example .env.local
# Placeholder values only. Never commit real keys.

# Local Express proxy (apps/api loads .env.local)
# Claude API key, used by POST /api/ai (Pages secret of the same name in production)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# PORT=3001
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudflare Pages Functions: set these as Pages secrets in production,
# or in .dev.vars when running `wrangler pages dev`.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# AUTH_BASE_URL=http://localhost:3000
# ALLOWED_EMAIL_DOMAINS=example.com
# Comma-separated accounts that are never charged points (shown as 999999)
# ADMIN_EMAILS=admin@example.com

# Deployment scripts (scripts/check-cf.ts reads ./.env or ADAPTIVA_ENV_PATH)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
